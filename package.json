{
  "name": "sekwe",
  "version": "0.0.0",
  "description": "A writing page for solo roleplaying games: oracles from Orangey roll straight into the story. Works offline, keeps everything on your device.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode single",
    "preview": "vite preview",
    "serve:both": "node scripts/serve-both.mjs",
    "sync": "node scripts/sync-orangey.mjs",
    "sync:status": "node scripts/sync-orangey.mjs --status",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/unit/*.test.ts\" \"vendor/orangey/tests/unit/*.test.ts\"",
    "test:browser": "node tests/browser/run.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4"
  }
}
